{
  "capabilities": {
    "can_redeploy": true,
    "can_resume": true,
    "can_stop": true,
    "can_update_while_running": false
  },
  "category": "Traffic Tools",
  "deployment": {
    "sdk_config_template": {
      "config": {
        "Traffic Generator URL": "{{env.TG_URL}}",
        "Traffic Generator DNS Override": "{{env.TG_DNS_OVERRIDE}}",
        "XFF Header Name": "{{env.XFF_HEADER_NAME}}",
        "Rate Limit": "{{env.RATE_LIMIT}}",
        "Simulated Users": "{{env.SIM_USERS}}",
        "Minimum Session Length": "{{env.MIN_SESSION_LENGTH}}",
        "Maximum Session Length": "{{env.MAX_SESSION_LENGTH}}",
        "Debug": "{{env.DEBUG_MODE}}",
        "Ignore SSL Errors": "{{env.IGNORE_SSL_ERRORS}}",
        "Trusted CA Certificate": "{{env.TRUSTED_CA_CERT}}"
      },
      "sitemap": "{{sitemap_json_for_env.SITEMAP_ID}}"
    },
    "default_env_vars": [
      {
        "label": "Traffic Generator URL",
        "name": "TG_URL",
        "required": true,
        "type": "string"
      },
      {
        "label": "Traffic Generator DNS Override",
        "name": "TG_DNS_OVERRIDE",
        "type": "string"
      },
      {
        "default_value": "X-Forwarded-For",
        "label": "XFF Header Name",
        "name": "XFF_HEADER_NAME",
        "type": "string"
      },
      {
        "default_value": 100,
        "label": "Rate Limit",
        "name": "RATE_LIMIT",
        "type": "integer"
      },
      {
        "default_value": 50,
        "label": "Simulated Users",
        "name": "SIM_USERS",
        "type": "integer"
      },
      {
        "default_value": 10,
        "label": "Minimum Session Length",
        "name": "MIN_SESSION_LENGTH",
        "type": "integer"
      },
      {
        "default_value": 30,
        "label": "Maximum Session Length",
        "name": "MAX_SESSION_LENGTH",
        "type": "integer"
      },
      {
        "label": "Select Sitemap",
        "name": "SITEMAP_ID",
        "required": true,
        "type": "string",
        "ui_type": "sitemap_select"
      },
      {
        "default_value": false,
        "label": "Debug",
        "name": "DEBUG_MODE",
        "type": "boolean"
      },
      {
        "default_value": true,
        "label": "Ignore SSL Errors",
        "name": "IGNORE_SSL_ERRORS",
        "type": "boolean"
      },
      {
        "label": "Trusted CA Certificate (PEM)",
        "name": "TRUSTED_CA_CERT",
        "type": "string",
        "ui_type": "json_textarea"
      }
    ]
  },
  "deploymentContext": "app",
  "description": "Generate continuous web/API traffic for testing using ShowRunner SDK. Writes /report/report.json for ShowRunner to pull (per-status-code measures + target-health playbook).",
  "displayName": "Traffic Generator",
  "icon": "fas fa-sync",
  "id": "traffic-generator-cli",
  "image_id_ref": "razor29/traffic-generator-cli",
  "lifecycleOptions": [
    {
      "description": "Generate traffic continuously until stopped.",
      "isDefault": true,
      "label": "Continuous",
      "lifecycle": "stateful"
    },
    {
      "description": "Generate traffic during a scheduled time window (start to end time).",
      "label": "Scheduled",
      "lifecycle": "scheduled",
      "scheduling_fields": {
        "end_time_utc": {
          "label": "End Time (UTC)",
          "required": true
        },
        "start_time_utc": {
          "label": "Start Time (UTC)",
          "required": true
        },
        "type": "one_time"
      }
    }
  ],
  "monitoring": {
    "prometheus": {
      "enabled": true,
      "scrape_path": "/metrics",
      "scrape_port_number": 9090
    }
  },
  "sdk": {
    "contract_version": 1,
    "capabilities": ["report_pull_file", "measures"],
    "reporting": {
      "mode": "file",
      "path": "/report/report.json",
      "sealed_field": "status",
      "sealed_value": "final",
      "poll_interval_sec": 30
    },
    "measures": [
      {
        "key": "responses.by_code",
        "label": "HTTP response codes",
        "type": "count_by_enum",
        "unit": "responses",
        "options": [200, 301, 400, 403, 404, 429, 500, 503],
        "options_open": true,
        "source": { "kind": "report_json", "path": "responses.by_code" },
        "success_checkable": true
      },
      {
        "key": "responses.total",
        "label": "Total responses",
        "type": "count",
        "unit": "responses",
        "source": { "kind": "report_json", "path": "responses.total" },
        "success_checkable": true
      },
      {
        "key": "responses.errors",
        "label": "Error responses (>= 400)",
        "type": "count",
        "unit": "responses",
        "source": { "kind": "report_json", "path": "responses.errors" },
        "success_checkable": true
      },
      {
        "key": "responses.error_ratio",
        "label": "Error ratio",
        "type": "ratio",
        "unit": "fraction",
        "higher_is_better": false,
        "source": { "kind": "report_json", "path": "responses.error_ratio" },
        "success_checkable": true
      },
      {
        "key": "rps",
        "label": "Requests/sec",
        "type": "number",
        "unit": "rps",
        "source": { "kind": "prometheus", "metric": "traffic_rps" },
        "success_checkable": false
      }
    ],
    "default_playbook": {
      "steps": [
        {
          "id": "target_absorbed_traffic",
          "name": "Target stayed healthy under legitimate load",
          "check": { "source": "report", "field": "responses.error_ratio", "op": "<", "value": 0.5 }
        },
        {
          "id": "traffic_flowed",
          "name": "Traffic reached the target",
          "check": { "source": "report", "field": "responses.total", "op": ">=", "value": 1 }
        }
      ]
    }
  },
  "subCategory": "Load Generation",
  "taskLifecycle": "stateful",
  "ui": {
    "card_basic_metrics": [
      {
        "label": "CPU",
        "max_value": 100,
        "source_path": "system.cpu_percent",
        "unit": "%"
      },
      {
        "label": "Memory",
        "max_value": 100,
        "source_path": "system.memory_percent",
        "unit": "%"
      }
    ],
    "card_info_fields": [
      {
        "label": "Target URL",
        "source_key": "TG_URL",
        "source_type": "env_var"
      }
    ],
    "card_primary_metric": {
      "label": "RPS",
      "source_path": "traffic_rps",
      "unit": ""
    },
    "card_secondary_metrics": [
      {
        "label": "Simulated Users",
        "source_path": "simulated_users",
        "fallback_env_var": "SIM_USERS",
        "unit": ""
      },
      {
        "label": "Rate Limit",
        "source_path": "rate_limit",
        "fallback_env_var": "RATE_LIMIT",
        "unit": ""
      }
    ],
    "deployment_form_sections": [
      {
        "fields": [
          "TG_URL",
          "TG_DNS_OVERRIDE",
          "XFF_HEADER_NAME",
          "RATE_LIMIT",
          "SIM_USERS",
          "MIN_SESSION_LENGTH",
          "MAX_SESSION_LENGTH",
          "SITEMAP_ID",
          "DEBUG_MODE",
          "IGNORE_SSL_ERRORS",
          "TRUSTED_CA_CERT"
        ],
        "title": "Traffic Generator Settings"
      }
    ]
  },
  "schema_version": 7
}
